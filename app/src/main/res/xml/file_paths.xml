<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- S-13：只开放在线更新安装包实际所在的目录，不再暴露整个外部存储/私有目录 -->
    <!-- 主路径：getExternalFilesDir(DIRECTORY_DOWNLOADS)/LMPlayerTV_update.apk -->
    <external-files-path name="tv_update_downloads" path="Download/" />
    <!-- 外部存储不可用时的回落路径：cacheDir/updates/ -->
    <cache-path name="tv_update_cache" path="updates/" />
</paths>
